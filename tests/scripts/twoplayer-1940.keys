# The 1940 scenario with two players, each played by Enter at every menu (the command each menu highlights).
# A digest at each of the 223 main menus and two at the Hall of Fame, then Quit.
# Written by tests/make_scripts.py.
#! seed 1940
#! cfg side=1 player=2

# Waits that any key ends; End Turn and End Game: Yes; any other menu: Enter.
rule 1 key space
rule 2 key enter
rule 2:E text y

# The title menu: Start NEW Game. Start Year: the scenario's entry.
play until 2:W
digest
text s
play until 2:S
key down
prompt
digest
key enter

# Each main menu (END TURN where Enter changes nothing).
repeat 43
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 7
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 8
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 6
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 7
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 6
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 111
play until 2:M
digest
key enter
end

# The game is over: the Hall of Fame asks for each player's commander. No digest while INPUT
# waits: its cursor blinks by the clock. A digest at the pause after the names, and at the table
# of new high scores.
play until 4
text Allies
key enter
prompt
text Axis
key enter
prompt
digest
key space
prompt
digest
key space

# Back at the title menu: Quit, and a key for END's "Press any key to continue".
play until 2:W
digest
text q
repeat space
