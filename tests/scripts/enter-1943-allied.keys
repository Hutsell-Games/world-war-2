# The 1943 scenario as the Allied side, played by Enter at every menu (the command each menu highlights); the computer plays the Axis side.
# A digest at each of the 77 main menus and two at the Hall of Fame, then Quit.
# Written by tests/make_scripts.py.
#! seed 1943
#! cfg side=1

# Waits that any key ends; End Turn and End Game: Yes; any other menu: Enter.
# No commander free at Recruit: Space, then Esc.
rule 1 key space
rule 2 key enter
rule 1:N key space key esc
rule 2:E text y

# The title menu: Start NEW Game. Start Year: the scenario's entry.
play until 2:W
digest
text s
play until 2:S
key down
prompt
key down
prompt
key down
prompt
key down
prompt
digest
key enter

# Each main menu (END TURN where Enter changes nothing).
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 2
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 2
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 2
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 2
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 5
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e
repeat 4
play until 2:M
digest
key enter
end
play until 2:M
digest
text e

# The game is over: the Hall of Fame asks for each player's commander. No digest while INPUT
# waits: its cursor blinks by the clock. A digest at the pause after the names, and at the table
# of new high scores.
play until 4
text Tester
key enter
prompt
digest
key space
prompt
digest
key space

# Back at the title menu: Quit, and a key for END's "Press any key to continue".
play until 2:W
digest
text q
repeat space
