' ===========================================================================
' FOLDERS.BI - the folders that hold the game's data files, relative to the
' folder the game runs in. The DOS game kept every file beside the program.
' Included by WW2.BI and EDIT.BI. The forward slash works on Windows too.
' ===========================================================================
CONST GFXDIR = "graphics/"      ' pictures (.VGA), help screens (.SC1, .SC2), map drawings (.GRF)
CONST SNDDIR = "sound/"         ' sound effects (.VOC) and tunes (.MID)
CONST SCNDIR = "scenarios/"     ' scenarios (EURO*.DAT, WW*.INI), WW2BASE.INI, SPECIAL.EVT
