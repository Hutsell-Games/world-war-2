' ===========================================================================
' SCRIPT.BM - hooks for the whole-game scripts of tests\play.py.
' Included at the end of WW2.BAS and EDIT.BAS. See tests\README.md.
'
' A game started with the environment variable WW2_SEED set is "scripted":
'   - RANDOMIZE takes that number instead of TIMER, so every run is the same;
'   - each wait for a key is announced in bytes &H4F0 to &H4F2 of memory,
'     which QB64 does not use, so that a keys file gives each key only when
'     the game waits for it (QB64Rust's tools\screen\README.md, "Prompts");
'   - a timed pause (TICK with a time above 0) returns at once;
'   - a saved game holds the date 01-01-2000 instead of today's.
' A game started without it plays as before: announce does nothing.
' The editor calls scriptcheck instead of scriptstart: it never called
' RANDOMIZE, and it has no saved games.
' ===========================================================================

' Seeds the random numbers, from WW2_SEED when it is set, else from TIMER.
SUB scriptstart
seed$ = ENVIRON$("WW2_SEED")
IF seed$ = "" THEN RANDOMIZE TIMER: EXIT SUB
scripted = 1
RANDOMIZE VAL(seed$)
END SUB

' The date a saved game holds: today's, or a fixed one when the game is
' scripted, so that the Saved Games menu shows the same in every run.
FUNCTION scriptdate$
IF scripted THEN scriptdate$ = "01-01-2000" ELSE scriptdate$ = DATE$
END FUNCTION

' Sets scripted when WW2_SEED is set, and seeds nothing (the editor).
SUB scriptcheck
IF ENVIRON$("WW2_SEED") <> "" THEN scripted = 1
END SUB

' SHELL cmd$, or under a script the same work done in BASIC. The game and
' the editor run "copy <from> <to>" (the editor's .bak files, the PBM file's
' .old copy). A SHELL starts cmd.exe, whose console window shows on the
' user's desktop even when the program runs on a hidden one, so the scripts
' must not run it. The copy replaces <to>, as copy does; a missing <from>
' copies nothing, as copy then only prints a message.
SUB scriptshell (cmd$)
IF ENVIRON$("WW2_SEED") = "" THEN SHELL cmd$: EXIT SUB
c$ = LTRIM$(RTRIM$(cmd$))
sp = INSTR(c$, " "): verb$ = LCASE$(LEFT$(c$, sp - 1)): args$ = LTRIM$(MID$(c$, sp + 1))
sp = INSTR(args$, " "): from$ = LEFT$(args$, sp - 1): into$ = LTRIM$(MID$(args$, sp + 1))
IF verb$ <> "copy" THEN SHELL cmd$: EXIT SUB
IF NOT _FILEEXISTS(from$) THEN EXIT SUB
f = FREEFILE: OPEN from$ FOR BINARY AS #f
d$ = SPACE$(LOF(f)): GET #f, , d$: CLOSE #f
IF _FILEEXISTS(into$) THEN KILL into$
f = FREEFILE: OPEN into$ FOR BINARY AS #f: PUT #f, , d$: CLOSE #f
END SUB

' Says that the game is about to wait for a key. place names the kind of
' wait (1 to 255) and letter$ narrows it (its first character, or ""):
'   1  a pause that any key ends (TICK)
'   2  a menu; letter$ is the first letter of the menu's title
'   3  a wait for a key or a mouse button (Mickey)
'   4  a line of text: the commander's name for the high scores (INPUT),
'      the editor's description of a scenario (Enput, EDIT.BAS)
'   5  the news of a play-by-mail game
'   6  the boss screen, which only Ctrl+B ends
'   7  the editor's number to change (plusminus, EDIT.BAS)
' Byte &H4F1 holds the place, &H4F2 the letter, and &H4F0 counts the waits.
SUB announce (place, letter$)
IF scripted = 0 THEN EXIT SUB
code = 0
IF letter$ <> "" THEN code = ASC(UCASE$(letter$))
DEF SEG = 0
POKE &H4F1, place
POKE &H4F2, code
POKE &H4F0, (PEEK(&H4F0) + 1) AND 255
DEF SEG
END SUB
